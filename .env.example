# ==========================================
# CONFIGURACIÓN GENERAL DEL SISTEMA
# ==========================================
NODE_ENV=development
APP_NAME="Paramo Urbano Core"
APP_VERSION=2.0.0
APP_PORT=4000
FRONTEND_PORT=3000

# ==========================================
# BASE DE DATOS TRANSACCIONAL (POSTGRESQL)
# ==========================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=paramo_db
DB_USER=paramo_admin
DB_PASSWORD=paramo_secure_pass
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# ==========================================
# COLA ASÍNCRONA Y CACHÉ (REDIS)
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=paramo_redis_pass
REDIS_URL="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}"

# ==========================================
# ALMACENAMIENTO DE OBJETOS BINARIOS (MINIO / S3)
# ==========================================
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secure_pass
MINIO_USE_SSL=false
STORAGE_BUCKET_RAW_ACTIVITIES=paramo-raw-telemetry

# ==========================================
# SEGURIDAD Y TOKENS JWT
# ==========================================
JWT_SECRET=super_secret_jwt_key_paramo_urban_2026_dev
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ==========================================
# REGLAS Y LIMITES DE TELEMETRÍA
# ==========================================
MAX_UPLOAD_FILE_SIZE_BYTES=26214400 # 25MB
ENABLE_BAROMETRIC_ALTITUDE_SMOOTHING=true
ALTITUDE_SMOOTHING_THRESHOLD_METERS=3.0

# ==========================================
# EXPOSICIÓN PÚBLICA / TÚNEL, CORS Y ASISTENTE
# ==========================================
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:4000,http://127.0.0.1:4000,http://localhost:5173,http://127.0.0.1:5173"
PUBLIC_TUNNEL_ENABLED=true
PUBLIC_URL=""
WHATSAPP_SUPPORT_PHONE="593999999999"
